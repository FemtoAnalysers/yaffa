  "In[1013]:=",ExpressionUUID->"df4ed95b-8e4d-458b-8b77-663114ab787f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sourceAAB", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"SourceHC", "*", " ", 
       RowBox[{"Integrate", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"dcost12", ",", " ", 
           RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}], "*", 
       RowBox[{"Integrate", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"dcost312", ",", " ", 
           RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}], 
       RowBox[{"Integrate", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"dphi12", ",", " ", "0", ",", " ", 
           RowBox[{"2", "Pi"}]}], "}"}]}], "]"}], 
       RowBox[{"Integrate", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"dphi312", ",", " ", "0", ",", " ", 
           RowBox[{"2", "Pi"}]}], "}"}]}], "]"}]}], " ", "/.", 
      RowBox[{"m1", "->", "m"}]}], " ", "/.", " ", 
     RowBox[{"m2", "->", "m"}]}], " ", "/.", 
    RowBox[{"s1", "->", "s"}]}], "/.", 
   RowBox[{"s2", "->", "s", " "}]}]}]], "Input",
 CellChangeTimes->{{3.977218974706008*^9, 3.977218981878612*^9}, {
   3.9772190261294727`*^9, 3.977219055392192*^9}, {3.9772191215521917`*^9, 
   3.9772191221471777`*^9}, {3.977219230182925*^9, 3.977219243798752*^9}, {
   3.977219766488284*^9, 3.9772198250033827`*^9}, {3.977219957383759*^9, 
   3.977219970990088*^9}, {3.977220217047346*^9, 3.977220220975567*^9}, {
