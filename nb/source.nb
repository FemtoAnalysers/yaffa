      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{"E12", " ", "+", " ", "E312", " ", "+", " ", "EPart"}], ",", 
        " ", 
        RowBox[{"(", 
         RowBox[{"M", " ", 
          RowBox[{
           RowBox[{"\[Rho]", "^", "2"}], "/", 
           RowBox[{"(", 
            RowBox[{"m1", " ", "+", "m2"}], ")"}]}]}], ")"}]}], "]"}], ",", 
      " ", 
      RowBox[{"1", "/", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["s2", "2"], " ", 
          SuperscriptBox["s3", "2"]}], "+", 
         RowBox[{
          SuperscriptBox["s1", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["s2", "2"], "+", 
            SuperscriptBox["s3", "2"]}], ")"}]}]}], ")"}]}]}], "]"}], "]"}], 
   RowBox[{"(*", " ", 
    RowBox[{"keep", " ", 
     RowBox[{"\[Rho]", "^", "5"}], " ", "separate"}], " ", 
    "*)"}]}]}]], "Input",
