     RowBox[{"(", 
      RowBox[{"mu12", " ", "mu312"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"3", "/", "2"}], ")"}]}]}], "norm", " ", "*", " ", 
   RowBox[{"Exp", "[", 
    RowBox[{"Collect", "[", 
