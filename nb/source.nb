 CellLabel->
  "In[1014]:=",ExpressionUUID->"762b94a9-bd05-46d1-9c58-cc0e53ef86ba"],

Cell[BoxData[
 FractionBox[
  RowBox[{"2", " ", 
   SuperscriptBox["\[ExponentialE]", 
    FractionBox[
     RowBox[{"M", " ", 
      SuperscriptBox["\[Rho]", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", 
              SuperscriptBox["m", "2"], " ", 
              SuperscriptBox["s", "2"]}], "+", 
             RowBox[{"4", " ", 
              SuperscriptBox["m", "2"], " ", 
              SuperscriptBox["s3", "2"]}]}], ")"}], " ", 
           SuperscriptBox[
            RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}], "2"]}], 
          RowBox[{"2", " ", 
           SuperscriptBox["m", "2"]}]]}], "-", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "m"}], "+", "m3"}], ")"}], " ", 
          SuperscriptBox["s", "2"], " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}], "2"]}], "m3"]}], ")"}]}], 
     RowBox[{"2", " ", "m", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["s", "2"], " ", 
         SuperscriptBox["s3", "2"]}], "+", 
        RowBox[{
         SuperscriptBox["s", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["s", "2"], "+", 
           SuperscriptBox["s3", "2"]}], ")"}]}]}], ")"}]}]]], " ", 
   SuperscriptBox["M", "3"]}], 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{
       SuperscriptBox["m", "2"], " ", "m3"}], 
      RowBox[{
       RowBox[{"2", " ", "m"}], "+", "m3"}]], ")"}], 
    RowBox[{"3", "/", "2"}]], " ", "\[Pi]", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["s", "2"], " ", 
       SuperscriptBox["s3", "2"]}], "+", 
      RowBox[{
       SuperscriptBox["s", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["s", "2"], "+", 
         SuperscriptBox["s3", "2"]}], ")"}]}]}], ")"}], 
    RowBox[{"3", "/", "2"}]]}]]], "Output",
 CellChangeTimes->{{3.977219122449664*^9, 3.977219130945331*^9}, {
   3.977219234248343*^9, 3.977219244043594*^9}, {3.977219774752139*^9, 
