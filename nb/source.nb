Cell[CellGroupData[{

Cell["Source for AAB systems averaged over the hyper-angle", "Subsubsection",
 CellChangeTimes->{{3.9863564170053368`*^9, 3.986356444532221*^9}, 
   3.986356690766449*^9},ExpressionUUID->"a1b54ace-f7d3-41c8-a552-\
5650e11fab5d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sourceAABAvgPhi", " ", "=", " ", 
  RowBox[{
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}], "^", "2"}], "*", 
      RowBox[{
       RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}], "^", "2"}], " ", 
      "sourceAAB"}], ",", "  ", 
     RowBox[{"{", 
      RowBox[{"\[CurlyPhi]", ",", " ", "0", ",", " ", 
       RowBox[{"Pi", "/", "2"}]}], "}"}]}], "]"}], " ", "//", 
   "FullSimplify"}]}]], "Input",
 CellChangeTimes->{{3.986356447917849*^9, 3.9863565859213142`*^9}, {
  3.9863567680765247`*^9, 3.986356777937086*^9}, {3.986357331236635*^9, 
  3.9863573667188177`*^9}, {3.986357749544791*^9, 3.9863578037066*^9}, {
  3.986358105433256*^9, 3.9863581759771757`*^9}, {3.986358212341836*^9, 
  3.986358221046256*^9}, {3.986358258213272*^9, 3.9863582867430573`*^9}},
 CellLabel->
  "In[1015]:=",ExpressionUUID->"3c04d995-3f95-4b47-878b-9b029671837b"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"M", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"m", "+", "m3"}], ")"}], " ", 
          SuperscriptBox["s", "2"]}], "+", 
         RowBox[{"m3", " ", 
          SuperscriptBox["s3", "2"]}]}], ")"}], " ", 
       SuperscriptBox["\[Rho]", "2"]}], 
      RowBox[{"2", " ", "m", " ", "m3", " ", 
       SuperscriptBox["s", "2"], " ", 
