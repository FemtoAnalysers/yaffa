Cell[TextData[{
 "Integrate over R via 3D gaussian integral. Using\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Integral]", 
         SuperscriptBox[
          StyleBox["d", "TI"], "3"], 
         StyleBox["R", "TI"], " ", "exp", 
         RowBox[{"{", 
           RowBox[{"-", 
             FractionBox["1", "2"], "\[Alpha]", 
             SuperscriptBox[
              OverscriptBox[
               StyleBox["R", "TI"], "\[RightVector]"], "2"], "+", 
             OverscriptBox["\[Beta]", "\[RightVector]"], "\[CenterDot]", 
             OverscriptBox[
              StyleBox["R", "TI"], "\[RightVector]"], "+", "\[Gamma]"}], 
           "}"}], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            FractionBox[
             RowBox[{"2", "\[Pi]"}], "\[Alpha]"], ")"}], 
          RowBox[{"3", "/", "2"}]], "exp", 
         RowBox[{"{", 
           RowBox[{
             FractionBox[
              SuperscriptBox[
               OverscriptBox["\[Beta]", "\[RightVector]"], "2"], 
              RowBox[{"2", "\[Alpha]"}]], "+", "\[Gamma]"}], "}"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\int d^3R \\, \\exp\\left\\{-\\frac{1}{2}\\alpha \\vec{R}^2 + \
\\vec{\\beta}\\cdot\\vec{R} + \\gamma\\right\\} =\\left(\\frac{2 \
\\pi}{\\alpha}\\right)^{3/2}\\exp\\left\\{\\frac{\\vec{\\beta}^2}{2{\\alpha}} \
+ \\gamma\\right\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "66e294b0-6fd9-4362-a71b-06352457b582"],
 " "
}], "Text",
 CellChangeTimes->{{3.99414566474446*^9, 3.994145666250958*^9}, {
  3.994147185667716*^9, 3.9941472347616587`*^9}, {3.994147467039782*^9, 
  3.994147498515832*^9}, {3.994147576384959*^9, 3.994147613109358*^9}, {
  3.9941476910299673`*^9, 3.994147692111664*^9}, {3.994147778765234*^9, 
  3.994147782516329*^9}, {3.99415047692286*^9, 
  3.994150477519148*^9}},ExpressionUUID->"b90fd85a-9e50-4974-bf54-\
89405114e660"],

