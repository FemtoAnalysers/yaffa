Cell[BoxData[
 RowBox[{
  RowBox[{"GaussianIntegral3D", "[", 
   RowBox[{"alpha_", ",", "beta_", ",", "gamma_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"2", " ", 
      RowBox[{"Pi", "/", "alpha"}]}], ")"}], "^", 
    RowBox[{"(", 
     RowBox[{"3", "/", "2"}], ")"}]}], " ", 
   RowBox[{"Exp", "[", 
    RowBox[{"gamma", "+", 
     RowBox[{
      RowBox[{"beta", "^", "2"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "alpha"}], ")"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.994150312567123*^9, 3.99415031256715*^9}, {
  3.994150347795823*^9, 3.99415035246836*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"5922ff4d-0b08-481c-94df-e2d98409ca64"],

